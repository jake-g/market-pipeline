# Rename to .env to apply local overrides.

# Unique HTTP User-Agent string to prevent API blocks for scraper tools
HTTP_USER_AGENT="Stonk stonk@market.com"

# API Key for historical price queries via AlphaVantage
# Obtain from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=0000000000FFFFFF

# NotebookLM Integration:
# Set to 1 to block NotebookLM entirely, 0 to leave it enabled.
DISABLE_NOTEBOOKLM_UPLOAD=0
